# Supabase (local dev — fill from `supabase status` output after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Supabase service role — NEVER expose to browser, server-only
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Hostname-safe marketing (both optional)
# The AF pilot host never serves the public Lospia marketing pages.
NEXT_PUBLIC_AF_OPERATIONS_HOST=operasyon.aslifilinta.com
# CAUTION: code default is "true" when unset. Keep "false" on the AF
# production deployment until the Lospia domain is intentionally attached.
NEXT_PUBLIC_MARKETING_SITE_ENABLED=false

# Feature flags (all off by default; flip to "true" to enable)
NEXT_PUBLIC_FEATURE_UPLOADS_ENABLED=false
NEXT_PUBLIC_FEATURE_SLACK_ENABLED=false
NEXT_PUBLIC_FEATURE_EMAIL_TO_TASK_ENABLED=false
NEXT_PUBLIC_FEATURE_AI_ENABLED=false
NEXT_PUBLIC_FEATURE_REALTIME_ENABLED=false

# AI provider (optional — app boots without it)
# ANTHROPIC_API_KEY=your-key
# AI_MODEL=claude-opus-4-8

# Slack incoming webhook (optional, only when SLACK feature flag is true)
# SLACK_SIGNING_SECRET=your-secret

# Email-to-task inbound route (optional, only when EMAIL_TO_TASK flag is true)
# EMAIL_INBOUND_SECRET=your-hmac-secret

# Email notifications (lead.received + task.assigned)
# ALL of these are private/server-only. NEVER prefix any with NEXT_PUBLIC_.
# With EMAIL_NOTIFICATIONS_ENABLED unset/"false" no mail is ever sent (noop),
# so production stays silent until this is intentionally flipped to "true".
EMAIL_NOTIFICATIONS_ENABLED=false
# Provider: "noop" (default, sends nothing) or "gmail".
EMAIL_PROVIDER=noop
EMAIL_FROM=sirac@lospia.com
EMAIL_FROM_NAME=AF Operasyon
# Internal address that receives new request-access lead notifications.
LEAD_NOTIFICATION_TO=sales@lospia.com
# Base URL used to build task links in mails ({baseUrl}/tasks/{taskId}).
EMAIL_TASK_BASE_URL=https://operasyon.aslifilinta.com
# Gmail API provider (only read when EMAIL_PROVIDER=gmail). Server-only secrets.
# GMAIL_SENDER is the authenticated mailbox; use send-as in Gmail to send from
# an alias (e.g. notifications@lospia.com) by setting EMAIL_FROM to that alias.
GMAIL_SENDER=sirac@lospia.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
