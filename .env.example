# Supabase (local dev — fill from `supabase status` output after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Supabase service role — NEVER expose to browser, server-only
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Hostname-safe marketing (both optional — safe defaults shown)
# The AF pilot host never serves the public Lospia marketing pages.
NEXT_PUBLIC_AF_OPERATIONS_HOST=operasyon.aslifilinta.com
# Set to "false" to disable the public marketing site everywhere.
NEXT_PUBLIC_MARKETING_SITE_ENABLED=true

# Feature flags (all off by default; flip to "true" to enable)
NEXT_PUBLIC_FEATURE_UPLOADS_ENABLED=false
NEXT_PUBLIC_FEATURE_SLACK_ENABLED=false
NEXT_PUBLIC_FEATURE_EMAIL_TO_TASK_ENABLED=false
NEXT_PUBLIC_FEATURE_AI_ENABLED=false
NEXT_PUBLIC_FEATURE_REALTIME_ENABLED=false

# AI provider (optional — app boots without it)
# ANTHROPIC_API_KEY=your-key
# AI_MODEL=claude-opus-4-8

# Slack incoming webhook (optional, only when SLACK feature flag is true)
# SLACK_SIGNING_SECRET=your-secret

# Email-to-task inbound route (optional, only when EMAIL_TO_TASK flag is true)
# EMAIL_INBOUND_SECRET=your-hmac-secret
