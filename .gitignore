# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example only, ignore all others
.env
.env.*
!.env.example
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local temp files
supabase/.temp/

# local import data (never commit customer files)
data/
# Exempt the demo-video data module: it is generic demo data (no customer /
# no Aslı Filinta production data) and the Remotion composition imports it, so
# it must be committed despite the blanket data/ rule above.
!remotion/data/
!remotion/data/**
*.xlsx
*.xls
*.csv

# local planning / notes
plan.md

# reference-only vendored repos (tablecn, react-spreadsheet-import) — inspected
# for UI/table patterns only; never committed, imported, or bundled.
/example/

# local source/asset files not part of app bundle — the optimized,
# committed copies live in public/brands/.
AF_logo.png
AF_logo.jpeg
AF.png
AF_.psd
aslifilinta.png
asli_filinta_logo_transparent.png

# local utility scripts not for production
scripts/import-*.ts

# üretim föyü kaynak Excel/PDF dosyaları — uygulamaya seed edildi, repo'ya girmez
uretim_foyu/
gemini.md

# kök dizindeki çalışma artefaktları — ekran görüntüleri, toplantı kayıtları,
# lookbook/pdf kaynakları repo'ya girmez (veri: sistemde; tasarım: Canva'da)
/Ekran Resmi*.png
/*.pdf
/toplanti_transkript*.md
/veri/
